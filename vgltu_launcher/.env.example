# === ОБЯЗАТЕЛЬНЫЕ СЕКРЕТЫ ===
BOT_TOKEN=your_telegram_bot_token_here
# Случайный секрет Bot -> Backend для входа в админку; сгенерируйте `openssl rand -hex 32`.
BOT_CALLBACK_SECRET=
# Числовые Telegram ID админов через запятую; оставьте пустым для локального запуска без админов.
ADMIN_IDS=
BOT_USERNAME=Name_bot
# Числовой Telegram ID для обратной связи; оставьте пустым, если бот не используется.
DEVELOPER_CHAT_ID=

# === БАЗА ДАННЫХ ===
POSTGRES_USER=launcher
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
POSTGRES_DB=pixel_launcher

# === REDIS ===
REDIS_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE

# === MINIO (S3) ===
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
# Для прода с TLS установить в "true"
MINIO_USE_SSL=false

# === JWT ===
# Сгенерировать: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32

# === SFTP / RCON ===
# Сгенерировать: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SFTP_ENCRYPTION_KEY=

# === CORS (для прода) ===
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
